+from unittest.mock import MagicMock, patch
+
+from django.contrib.auth.models import User
+from django.test import Client, TestCase, override_settings
+
+from users_management.models import AdminApiToken, AdminProfile, AuditLog
+from users_management.rate_limit import reset_memory_rate_limits
+from users_management.totp import generate_totp_secret, get_totp_code
+
+LOGIN = '/dashboard/api/m/auth/login/'
+
+
+@override_settings(ENFORCE_SUPERADMIN_2FA=True)
+class MobileApiTests(TestCase):
+    def setUp(self):
+        reset_memory_rate_limits()
+        self.mod = User.objects.create_user('mod', password='Str0ng!Pass', is_staff=True)
+        AdminProfile.objects.create(user=self.mod, role='moderator')
+        self.viewer = User.objects.create_user('view', password='Str0ng!Pass', is_staff=True)
+        AdminProfile.objects.create(user=self.viewer, role='viewer')
+        self.boss = User.objects.create_user('boss', password='Str0ng!Pass', is_staff=True)
+        self.secret = generate_totp_secret()
+        AdminProfile.objects.create(user=self.boss, role='super_admin', totp_enabled=True, totp_secret=self.secret)
+        self.c = Client(enforce_csrf_checks=True)
+
+    def login(self, username, **extra):
+        return self.c.post(LOGIN, json.dumps({'username': username, 'password': 'Str0ng!Pass', **extra}),
+                           content_type='application/json')
+
+    def auth(self, token):
+        return {'HTTP_AUTHORIZATION': f'Bearer {token}'}
+
+    def test_login_issues_hashed_token_and_me_works(self):
+        r = self.login('mod', device='Pixel')
+        self.assertEqual(r.status_code, 200, r.content)
+        token = r.json()['token']
+        self.assertTrue(token.startswith('adm_'))
+        self.assertFalse(AdminApiToken.objects.filter(key_hash=token).exists())
+        self.assertTrue(AdminApiToken.objects.filter(key_hash=AdminApiToken.hash_key(token)).exists())
+        me = self.c.get('/dashboard/api/m/me/', **self.auth(token)).json()
+        self.assertEqual(me['admin']['role'], 'moderator')
+        self.assertIn('comments.delete', me['admin']['permissions'])
+        self.assertNotIn('settings.view', me['admin']['permissions'])
+        self.assertTrue(AuditLog.objects.filter(action='login', admin_username='mod').exists())
+
+    def test_wrong_password_and_bad_token(self):
+        self.assertEqual(self.c.post(LOGIN, json.dumps({'username': 'mod', 'password': 'x'}),
+                                     content_type='application/json').status_code, 401)
+        r = self.c.get('/dashboard/api/m/me/', **self.auth('adm_nope'))
+        self.assertEqual(r.status_code, 401)
+        self.assertEqual(r.json()['code'], 'token_invalid')
+        self.assertEqual(self.c.get('/dashboard/api/m/me/').status_code, 401)
+
+    def test_non_staff_rejected(self):
+        User.objects.create_user('joe', password='Str0ng!Pass')
+        self.assertEqual(self.login('joe').status_code, 403)
+
+    def test_2fa_flow(self):
+        r = self.login('boss')
+        self.assertTrue(r.json().get('requires_2fa'))
+        self.assertNotIn('token', r.json())
+        self.assertEqual(self.login('boss', otp='000000').status_code, 401)
+        r = self.login('boss', otp=get_totp_code(self.secret))
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertTrue(r.json()['admin']['is_super_admin'])
+
+    def test_super_admin_without_2fa_blocked(self):
+        u = User.objects.create_superuser('root', password='Str0ng!Pass')
+        self.assertEqual(self.login('root').json().get('code'), '2fa_setup_required')
+
+    def test_rbac_enforced(self):
+        token = self.login('mod').json()['token']
+        self.assertEqual(self.c.get('/dashboard/api/m/settings/', **self.auth(token)).status_code, 403)
+        self.assertEqual(self.c.get('/dashboard/api/m/admins/', **self.auth(token)).status_code, 403)
+        vtoken = self.login('view').json()['token']
+        r = self.c.post('/dashboard/api/m/users/507f1f77bcf86cd799439011/update/', '{}',
+                        content_type='application/json', **self.auth(vtoken))
+        self.assertEqual(r.status_code, 403)
+
+    def test_session_cookie_post_still_needs_csrf(self):
+        self.c.force_login(self.mod)
+        r = self.c.post('/dashboard/api/m/auth/logout/')
+        self.assertEqual(r.status_code, 403)  # CSRF failure, not exempt
+
+    def test_logout_revokes_token(self):
+        token = self.login('mod').json()['token']
+        self.assertEqual(self.c.post('/dashboard/api/m/auth/logout/', **self.auth(token)).status_code, 200)
+        self.assertEqual(self.c.get('/dashboard/api/m/me/', **self.auth(token)).status_code, 401)
+
+    def test_existing_json_endpoint_accepts_token_without_csrf(self):
+        token = self.login('mod').json()['token']
+        with patch('users_management.views_legacy.mongo_admin') as mm:
+            mm.set_comment_deleted.return_value = 1
+            r = self.c.post('/dashboard/api/mongo/comments/507f1f77bcf86cd799439011/hide/', **self.auth(token))
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertTrue(r.json()['success'])
+
+    def test_users_list_uses_mongo(self):
+        token = self.login('mod').json()['token']
+        fake_db = MagicMock()
+        fake_db.users.aggregate.side_effect = [
+            [{'_id': 'a1', 'name': 'An'}],
+            [{'_id': None, 'total': 1, 'verified': 1, 'banned': 0, 'google': 0}],
+        ]
+        fake_db.users.count_documents.return_value = 1
+        with patch('users_management.mobile_api.mongo_admin') as mm:
+            mm.db.return_value = fake_db
+            r = self.c.get('/dashboard/api/m/users/?search=an', **self.auth(token))
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertEqual(r.json()['total'], 1)
+
+    def test_super_admin_creates_admin(self):
+        token = self.login('boss', otp=get_totp_code(self.secret)).json()['token']
+        r = self.c.post('/dashboard/api/m/admins/', json.dumps(
+            {'action': 'create', 'username': 'newbie', 'password': 'An0ther!Strong', 'role': 'viewer'}),
+            content_type='application/json', **self.auth(token))
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertEqual(User.objects.get(username='newbie').admin_profile.role, 'viewer')
+
+    def test_backend_failure_returns_json(self):
+        token = self.login('mod').json()['token']
+        with patch('users_management.mobile_api.mongo_admin') as mm:
+            mm.db.side_effect = RuntimeError('MONGODB_URI is not configured')
+            r = self.c.get('/dashboard/api/m/users/', **self.auth(token))
+        self.assertEqual(r.status_code, 500)
+        self.assertIn('MONGODB_URI', r.json()['error'])
