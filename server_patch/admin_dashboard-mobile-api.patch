--- /dev/null
+++ b/users_management/mobile_api.py
@@ -0,0 +1,872 @@
+"""JSON API for the mobile admin app (Flutter).
+
+Auth: ``POST /dashboard/api/m/auth/login/`` exchanges username + password
+(+ TOTP / backup code when 2FA is on) for a Bearer token. Every other request
+sends ``Authorization: Bearer adm_...``; ``AdminTokenAuthMiddleware`` turns that
+into ``request.user`` so the existing RBAC (role defaults + per-admin
+overrides), rate limits and audit logs apply unchanged.
+
+Form-based HTML views (report moderation, settings, broadcast...) are reused
+through ``_run_form_view`` instead of duplicating their business logic.
+"""
+import json
+import re
+from datetime import datetime, timedelta
+
+from bson import ObjectId
+from django.conf import settings
+from django.contrib.auth import authenticate
+from django.contrib.auth.models import User
+from django.contrib.messages import get_messages
+from django.http import JsonResponse, QueryDict
+from django.utils import timezone
+from django.views.decorators.csrf import csrf_exempt
+from django.views.decorators.http import require_GET, require_POST
+
+from .models import (
+    ACTIONS, MODULES, MODULE_LABELS, ROLE_DEFAULTS,
+    AdminApiToken, AdminProfile, AuditLog, ErrorLog, SystemSetting,
+)
+from .rate_limit import (
+    check_rate_limit, clear_failures, consume_action_rate_limit,
+    format_retry_wait, get_client_ip, record_failure,
+)
+from .services import (
+    MONGO_COLLECTIONS, clean_value, invalidate_swr, mongo_admin, parallel_run,
+)
+from .totp import verify_and_consume_backup_code, verify_totp_code
+
+PAGE_MAX = 100
+
+
+# ── helpers ─────────────────────────────────────────────────────────
+def _ok(data=None, status=200):
+    payload = {'success': True}
+    payload.update(data or {})
+    return JsonResponse(payload, status=status)
+
+
+def _err(message, status=400, **extra):
+    payload = {'success': False, 'error': message}
+    payload.update(extra)
+    return JsonResponse(payload, status=status)
+
+
+def _body(request):
+    try:
+        return json.loads(request.body or '{}')
+    except (ValueError, UnicodeDecodeError):
+        return {}
+
+
+def _page_args(request, default_limit=20):
+    try:
+        page = max(int(request.GET.get('page', 1) or 1), 1)
+    except ValueError:
+        page = 1
+    try:
+        limit = min(max(int(request.GET.get('limit', default_limit) or default_limit), 1), PAGE_MAX)
+    except ValueError:
+        limit = default_limit
+    return page, limit, (page - 1) * limit
+
+
+def _profile(user):
+    try:
+        return user.admin_profile
+    except Exception:
+        return None
+
+
+def _is_super(user):
+    profile = _profile(user)
+    return bool(user.is_superuser or (profile and profile.role == 'super_admin'))
+
+
+def _has(user, perm):
+    if user.is_superuser:
+        return True
+    profile = _profile(user)
+    return bool(profile and profile.has_perm(perm))
+
+
+def _effective_perms(user):
+    if user.is_superuser:
+        return sorted(f'{m}.{a}' for m in MODULES for a in ACTIONS)
+    profile = _profile(user)
+    if not profile:
+        return []
+    return sorted(f'{m}.{a}' for m in MODULES for a in ACTIONS if profile.has_perm(f'{m}.{a}'))
+
+
+def _require_admin(request):
+    """Return an error response when the caller is not an authenticated admin."""
+    user = request.user
+    if not user.is_authenticated:
+        return _err('Authentication required', 401)
+    if not (user.is_staff or user.is_superuser):
+        return _err('Admin access required', 403)
+    if not user.is_superuser and not _profile(user):
+        return _err('Tài khoản quản trị chưa được cấp hồ sơ phân quyền.', 403)
+    return None
+
+
+def _guard(fn, request, *args, **kwargs):
+    """Turn unexpected exceptions into JSON so the app can show a real message."""
+    from django.http import Http404
+    try:
+        return fn(request, *args, **kwargs)
+    except Http404 as exc:
+        return _err(str(exc) or 'Không tìm thấy', 404)
+    except Exception as exc:  # noqa: BLE001 - surfaced to the admin, also logged
+        try:
+            ErrorLog.objects.create(level='error', message=str(exc)[:2000], request_path=request.path[:500],
+                                    request_method=request.method,
+                                    admin_user=request.user if request.user.is_authenticated else None)
+        except Exception:
+            pass
+        return _err(f'Lỗi server: {exc}', 500)
+
+
+def json_errors(fn):
+    def wrapped(request, *args, **kwargs):
+        return _guard(fn, request, *args, **kwargs)
+    wrapped.__name__ = fn.__name__
+    return wrapped
+
+
+def needs(perm):
+    """Decorator: admin auth + RBAC permission (string or tuple = any of)."""
+    codes = (perm,) if isinstance(perm, str) else tuple(perm)
+
+    def deco(fn):
+        def wrapped(request, *args, **kwargs):
+            denied = _require_admin(request)
+            if denied:
+                return denied
+            if not any(_has(request.user, c) for c in codes):
+                return _err(f'Permission denied ({", ".join(codes)})', 403)
+            return _guard(fn, request, *args, **kwargs)
+        wrapped.__name__ = fn.__name__
+        wrapped.__doc__ = fn.__doc__
+        # No csrf_exempt: Bearer-token requests skip CSRF in AdminTokenAuthMiddleware,
+        # while cookie-session callers stay CSRF-protected.
+        return wrapped
+    return deco
+
+
+def _oid(value):
+    if isinstance(value, ObjectId):
+        return value
+    if isinstance(value, str) and ObjectId.is_valid(value):
+        return ObjectId(value)
+    return None
+
+
+def _regex(text):
+    return {'$regex': re.escape(text), '$options': 'i'}
+
+
+def _run_form_view(request, view, data, *args, **kwargs):
+    """Call an HTML form view as a POST with ``data`` and translate its flash
+    messages + redirect into JSON. Keeps permission checks/rate limits/audit."""
+    qd = QueryDict(mutable=True)
+    for key, value in (data or {}).items():
+        if value is None:
+            continue
+        if isinstance(value, bool):
+            if value:
+                qd[key] = 'on'
+            continue
+        if isinstance(value, (list, tuple)):
+            qd.setlist(key, [str(v) for v in value])
+        else:
+            qd[key] = str(value)
+    request.method = 'POST'
+    request.POST = qd
+    response = view(request, *args, **kwargs)
+    msgs = [{'level': m.level_tag, 'text': str(m)} for m in get_messages(request)]
+    if response.status_code >= 400:
+        try:
+            payload = json.loads(response.content or b'{}')
+        except ValueError:
+            payload = {}
+        return _err(payload.get('error') or (msgs[-1]['text'] if msgs else f'HTTP {response.status_code}'),
+                    response.status_code, messages=msgs)
+    if response.get('Content-Type', '').startswith('application/json'):
+        return response
+    failed = any(m['level'] in ('error', 'danger') for m in msgs)
+    text = msgs[-1]['text'] if msgs else ('Thất bại' if failed else 'Đã thực hiện')
+    if failed:
+        return _err(text, 400, messages=msgs)
+    return _ok({'message': text, 'messages': msgs})
+
+
+def _admin_payload(user):
+    profile = _profile(user)
+    role = 'super_admin' if user.is_superuser and not profile else (profile.role if profile else '')
+    return {
+        'id': user.pk,
+        'username': user.username,
+        'email': user.email,
+        'first_name': user.first_name,
+        'last_name': user.last_name,
+        'is_superuser': user.is_superuser,
+        'role': role,
+        'is_super_admin': _is_super(user),
+        'avatar': (profile.avatar if profile else '') or '',
+        'totp_enabled': bool(profile and profile.totp_enabled),
+        'last_login': user.last_login.isoformat() if user.last_login else None,
+        'date_joined': user.date_joined.isoformat() if user.date_joined else None,
+        'permissions': _effective_perms(user),
+    }
+
+
+# ── auth ────────────────────────────────────────────────────────────
+@csrf_exempt
+@require_POST
+def m_login(request):
+    body = _body(request)
+    username = (body.get('username') or '').strip()
+    password = body.get('password') or ''
+    otp = re.sub(r'\s+', '', str(body.get('otp') or ''))
+    device = (body.get('device') or request.headers.get('User-Agent', ''))[:200]
+
+    allowed, retry_after, reason = check_rate_limit('admin_login', request, username)
+    if not allowed:
+        return _err(f'Quá nhiều lần đăng nhập thất bại ({reason}). Thử lại sau {format_retry_wait(retry_after)}.',
+                    429, retryAfter=retry_after)
+    if not username or not password:
+        return _err('Vui lòng nhập tên đăng nhập và mật khẩu.')
+
+    user = authenticate(request, username=username, password=password)
+    if user is None or not (user.is_staff or user.is_superuser) or not user.is_active:
+        remaining, locked_now, lock_wait = record_failure('admin_login', request, username)
+        if user is not None:
+            return _err('Tài khoản này không có quyền truy cập trang quản trị!', 403)
+        if locked_now:
+            return _err(f'Sai thông tin đăng nhập. Tạm khoá {format_retry_wait(lock_wait)}.', 429, retryAfter=lock_wait)
+        extra = f' (còn {remaining} lần thử)' if remaining <= 2 else ''
+        return _err(f'Tên đăng nhập hoặc mật khẩu không đúng!{extra}', 401)
+
+    profile = AdminProfile.objects.filter(user=user).first()
+    if not user.is_superuser and not profile:
+        return _err('Tài khoản quản trị chưa được cấp hồ sơ phân quyền.', 403)
+
+    method = 'password'
+    if profile and profile.totp_enabled and profile.totp_secret:
+        if not otp:
+            return _ok({'requires_2fa': True})
+        if verify_totp_code(profile.totp_secret, otp):
+            method = 'totp'
+        elif verify_and_consume_backup_code(profile, otp):
+            method = 'totp_backup'
+        else:
+            record_failure('admin_login', request, username)
+            return _err('Mã xác thực 2FA không đúng.', 401, requires_2fa=True)
+    elif _is_super(user) and getattr(settings, 'ENFORCE_SUPERADMIN_2FA', True):
+        return _err('Super Admin phải bật 2FA (TOTP) trên trang web quản trị trước khi đăng nhập app.', 403,
+                    code='2fa_setup_required')
+
+    clear_failures('admin_login', request, username)
+    days = int(getattr(settings, 'ADMIN_API_TOKEN_DAYS', 30))
+    raw, _ = AdminApiToken.issue(user, device, get_client_ip(request), days=days)
+    user.last_login = timezone.now()
+    user.save(update_fields=['last_login'])
+    request.user = user
+    try:
+        AuditLog.log(request, 'login', 'auth', str(user.pk),
+                     {'username': user.username, 'method': method, 'client': 'mobile_app'})
+    except Exception:
+        pass
+    return _ok({'token': raw, 'expires_in_days': days, 'admin': _admin_payload(user)})
+
+
+@require_POST
+def m_logout(request):
+    token = getattr(request, 'admin_api_token', None)
+    if token:
+        AuditLog.log(request, 'logout', 'auth', str(request.user.pk), {'client': 'mobile_app'})
+        token.delete()
+    return _ok()
+
+
+@needs('dashboard.view')
+@require_GET
+def m_me(request):
+    data = _admin_payload(request.user)
+    data['modules'] = [{'key': m, 'label': MODULE_LABELS.get(m, m)} for m in MODULES]
+    return _ok({'admin': data})
+
+
+@needs('dashboard.view')
+def m_tokens(request):
+    """List / revoke the caller's own app sessions."""
+    if request.method == 'POST':
+        body = _body(request)
+        tid = body.get('id')
+        qs = AdminApiToken.objects.filter(user=request.user)
+        if body.get('all_others'):
+            current = getattr(request, 'admin_api_token', None)
+            n, _ = qs.exclude(pk=getattr(current, 'pk', None)).delete()
+        else:
+            n, _ = qs.filter(pk=tid).delete()
+        return _ok({'deleted': n})
+    current = getattr(request, 'admin_api_token', None)
+    rows = [{
+        'id': t.pk, 'device': t.device_name, 'ip': t.ip_address, 'prefix': t.prefix,
+        'created_at': t.created_at.isoformat(),
+        'last_used_at': t.last_used_at.isoformat() if t.last_used_at else None,
+        'expires_at': t.expires_at.isoformat(),
+        'current': bool(current and current.pk == t.pk),
+    } for t in AdminApiToken.objects.filter(user=request.user)]
+    return _ok({'rows': rows})
+
+
+# ── users (MongoDB) ─────────────────────────────────────────────────
+_USER_HIDE = {
+    'password': 0, 'emailVerificationToken': 0, 'friends': 0,
+    'friendRequests': 0, 'sentFriendRequests': 0, 'watchlist': 0,
+}
+
+
+@needs('users.view')
+@require_GET
+def m_users(request):
+    page, limit, skip = _page_args(request)
+    search = request.GET.get('search', '').strip()
+    query = {}
+    if search:
+        ors = [{'name': _regex(search)}, {'email': _regex(search)}, {'username': _regex(search)}]
+        if _oid(search):
+            ors.append({'_id': _oid(search)})
+        query['$or'] = ors
+    verified = request.GET.get('verified', '')
+    if verified in ('true', 'false'):
+        query['isEmailVerified'] = True if verified == 'true' else {'$ne': True}
+    banned = request.GET.get('banned', '')
+    if banned in ('true', 'false'):
+        query['isBanned'] = True if banned == 'true' else {'$ne': True}
+    auth_type = request.GET.get('auth_type', '')
+    if auth_type == 'google':
+        query['authType'] = 'google'
+    elif auth_type == 'email':
+        query['authType'] = {'$ne': 'google'}
+    sort = {'name': ('name', 1), 'email': ('email', 1), 'oldest': ('createdAt', 1)}.get(
+        request.GET.get('sort', ''), ('createdAt', -1))
+
+    db = mongo_admin.db()
+    pipeline = ([{'$match': query}] if query else []) + [
+        {'$sort': {sort[0]: sort[1]}},
+        {'$skip': skip},
+        {'$limit': limit},
+        {'$addFields': {'watchlist_count': {'$size': {'$ifNull': ['$watchlist', []]}},
+                        'friends_count': {'$size': {'$ifNull': ['$friends', []]}}}},
+        {'$project': _USER_HIDE},
+    ]
+
+    def stats():
+        res = list(db.users.aggregate([{'$group': {
+            '_id': None,
+            'total': {'$sum': 1},
+            'verified': {'$sum': {'$cond': [{'$eq': ['$isEmailVerified', True]}, 1, 0]}},
+            'banned': {'$sum': {'$cond': [{'$eq': ['$isBanned', True]}, 1, 0]}},
+            'google': {'$sum': {'$cond': [{'$eq': ['$authType', 'google']}, 1, 0]}},
+        }}]))
+        doc = res[0] if res else {}
+        doc.pop('_id', None)
+        return doc
+
+    res = parallel_run({
+        'rows': lambda: list(db.users.aggregate(pipeline)),
+        'total': lambda: db.users.count_documents(query),
+        'stats': stats,
+    }, max_workers=3)
+    total = res['total']
+    return _ok({
+        'rows': clean_value(res['rows']), 'total': total, 'page': page, 'limit': limit,
+        'has_more': skip + len(res['rows']) < total, 'stats': clean_value(res['stats']),
+    })
+
+
+@needs('users.view')
+def m_user_detail(request, user_id):
+    oid = _oid(user_id)
+    if not oid:
+        return _err('ID không hợp lệ', 404)
+    db = mongo_admin.db()
+    user = db.users.find_one({'_id': oid}, {'password': 0, 'emailVerificationToken': 0})
+    if not user:
+        return _err('Không tìm thấy người dùng', 404)
+
+    ban_exp = user.get('banExpiresAt')
+    if user.get('isBanned') and isinstance(ban_exp, datetime) and ban_exp <= datetime.utcnow():
+        db.users.update_one({'_id': oid}, {'$set': {
+            'isBanned': False, 'banReason': '', 'banExpiresAt': None, 'bannedAt': None, 'bannedBy': ''}})
+        user.update({'isBanned': False, 'banReason': '', 'banExpiresAt': None})
+
+    res = parallel_run({
+        'sessions': lambda: list(db.sessions.find({'userId': oid}, {'refreshToken': 0}).sort('lastActive', -1).limit(20)),
+        'comments': lambda: list(db.comments.find({'userId': oid}).sort('createdAt', -1).limit(20)),
+        'comments_total': lambda: db.comments.count_documents({'userId': oid}),
+        'progress': lambda: list(db.watchprogresses.find({'userId': oid}).sort('lastWatched', -1).limit(20)),
+        'progress_total': lambda: db.watchprogresses.count_documents({'userId': oid}),
+        'searches': lambda: list(db.searchhistories.find({'$or': [{'user_id': oid}, {'userId': oid}]}).limit(1)),
+        'reports': lambda: db.userreports.count_documents({'reportedUserId': {'$in': [oid, str(oid)]}}),
+        'friends': lambda: list(db.users.find({'_id': {'$in': user.get('friends', [])[:50]}},
+                                              {'name': 1, 'email': 1, 'avatar': 1})),
+    }, max_workers=8)
+    for key in ('friendRequests', 'sentFriendRequests', 'friends'):
+        user[f'{key}_count'] = len(user.pop(key, []) or [])
+    return _ok({
+        'user': clean_value(user),
+        'sessions': clean_value(res['sessions']),
+        'comments': clean_value(res['comments']),
+        'comments_total': res['comments_total'],
+        'progress': clean_value(res['progress']),
+        'progress_total': res['progress_total'],
+        'search_history': clean_value(res['searches'][0]) if res['searches'] else None,
+        'reports_against': res['reports'],
+        'friends': clean_value(res['friends']),
+    })
+
+
+@needs('users.edit')
+@require_POST
+def m_user_update(request, user_id):
+    oid = _oid(user_id)
+    if not oid:
+        return _err('ID không hợp lệ', 404)
+    body = _body(request)
+    db = mongo_admin.db()
+    update = {'updatedAt': datetime.utcnow()}
+    for field in ('name', 'avatar'):
+        if field in body and body[field] is not None:
+            update[field] = str(body[field]).strip()
+    if body.get('username'):
