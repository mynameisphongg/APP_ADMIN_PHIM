+# ── Mobile admin app API tokens ─────────────────────────────────────
+class AdminApiToken(models.Model):
+    """Bearer token for the mobile admin app. Only the SHA-256 hash is stored."""
+    user = models.ForeignKey(User, on_delete=models.CASCADE, related_name='api_tokens')
+    key_hash = models.CharField(max_length=64, unique=True, db_index=True)
+    prefix = models.CharField(max_length=12, default='')
+    device_name = models.CharField(max_length=200, blank=True, default='')
+    ip_address = models.GenericIPAddressField(null=True, blank=True)
+    created_at = models.DateTimeField(auto_now_add=True)
+    last_used_at = models.DateTimeField(null=True, blank=True)
+    expires_at = models.DateTimeField(db_index=True)
+
+    class Meta:
+        ordering = ['-created_at']
+
+    def __str__(self):
+        return f"{self.user.username} · {self.prefix}… ({self.device_name})"
+
+    @staticmethod
+    def hash_key(raw_key):
+        import hashlib
+        return hashlib.sha256(raw_key.encode('utf-8')).hexdigest()
+
+    @classmethod
+    def issue(cls, user, device_name='', ip=None, days=30):
+        import secrets
+        from datetime import timedelta
+        raw = 'adm_' + secrets.token_urlsafe(40)
+        token = cls.objects.create(
+            user=user,
+            key_hash=cls.hash_key(raw),
+            prefix=raw[:12],
+            device_name=(device_name or '')[:200],
+            ip_address=ip or None,
+            expires_at=timezone.now() + timedelta(days=days),
+        )
+        return raw, token
