+def _admin_mutation(request):
+    """Create admin / change role / toggle active / revoke app sessions (super admin only)."""
+    if not _is_super(request.user):
+        return _err('Chỉ Super Admin mới thực hiện được thao tác này.', 403)
+    allowed, retry_after, _ = consume_action_rate_limit('admin_sensitive', request)
+    if not allowed:
+        return _err(f'Thao tác quá nhanh. Thử lại sau {format_retry_wait(retry_after)}.', 429)
+    body = _body(request)
+    action = body.get('action')
+    role = body.get('role')
+    if role and role not in ROLE_DEFAULTS:
+        return _err('Role không hợp lệ')
+
+    if action == 'create':
+        username = (body.get('username') or '').strip()
+        password = body.get('password') or ''
+        if not username or len(password) < 8:
+            return _err('Cần username và mật khẩu tối thiểu 8 ký tự')
+        if User.objects.filter(username=username).exists():
+            return _err('Username đã tồn tại')
+        from django.contrib.auth.password_validation import validate_password
+        from django.core.exceptions import ValidationError
+        try:
+            validate_password(password)
+        except ValidationError as exc:
+            return _err(' '.join(exc.messages))
+        u = User.objects.create_user(username=username, email=(body.get('email') or '').strip(),
+                                     password=password, is_staff=True)
+        AdminProfile.objects.create(user=u, role=role or 'viewer')
+        AuditLog.log(request, 'create_admin', 'admin', u.pk, {'username': username, 'role': role or 'viewer'})
+        return _ok({'message': f'Đã tạo admin {username}'})
+
+    try:
+        target = User.objects.get(pk=int(body.get('id')), is_staff=True)
+    except (User.DoesNotExist, TypeError, ValueError):
+        return _err('Không tìm thấy admin', 404)
+    if target.pk == request.user.pk and action in ('set_role', 'toggle_active'):
+        return _err('Không thể tự đổi quyền/khoá chính mình')
+    if target.is_superuser and not request.user.is_superuser:
+        return _err('Không thể thao tác trên superuser', 403)
+
+    if action == 'set_role':
+        profile, _ = AdminProfile.objects.get_or_create(user=target)
+        profile.role = role or profile.role
+        profile.save(update_fields=['role', 'updated_at'])
+        AuditLog.log(request, 'edit_admin', 'admin', target.pk, {'role': profile.role})
+        return _ok({'message': f'Đã đổi role {target.username} → {profile.role}'})
+    if action == 'toggle_active':
+        target.is_active = not target.is_active
+        target.save(update_fields=['is_active'])
+        if not target.is_active:
+            AdminApiToken.objects.filter(user=target).delete()
+        AuditLog.log(request, 'toggle_admin_active', 'admin', target.pk, {'is_active': target.is_active})
+        return _ok({'message': f'{target.username}: {"đã mở khoá" if target.is_active else "đã khoá"}'})
+    if action == 'revoke_tokens':
+        n, _ = AdminApiToken.objects.filter(user=target).delete()
+        AuditLog.log(request, 'revoke_admin_tokens', 'admin', target.pk, {'count': n})
+        return _ok({'message': f'Đã đăng xuất {n} phiên app của {target.username}'})
+    return _err('Hành động không hợp lệ')
+
