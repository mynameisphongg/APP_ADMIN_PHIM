+class AdminTokenAuthMiddleware:
+    """Authenticate the mobile admin app via ``Authorization: Bearer adm_...``.
+
+    Only applies to ``/dashboard/api/`` paths. A valid token sets ``request.user``
+    and skips CSRF (no cookies are involved, so CSRF does not apply). Every RBAC
+    check downstream (AdminAccessMiddleware, require_permission, _has_perm)
+    keeps working unchanged because it reads ``request.user``.
+    """
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        auth = request.headers.get('Authorization', '')
+        if request.path.startswith('/dashboard/api/') and auth.startswith('Bearer adm_'):
+            from django.utils import timezone
+            from .models import AdminApiToken
+
+            raw = auth[len('Bearer '):].strip()
+            token = (
+                AdminApiToken.objects.select_related('user')
+                .filter(key_hash=AdminApiToken.hash_key(raw))
+                .first()
+            )
+            now = timezone.now()
+            if not token or token.expires_at <= now or not token.user.is_active:
+                return JsonResponse(
+                    {'error': 'Invalid or expired token', 'ok': False, 'success': False, 'code': 'token_invalid'},
+                    status=401,
+                )
+            if not (token.last_used_at and (now - token.last_used_at).total_seconds() < 60):
+                AdminApiToken.objects.filter(pk=token.pk).update(last_used_at=now)
+            request.user = token.user
+            request._cached_user = token.user
+            request.admin_api_token = token
+            request._dont_enforce_csrf_checks = True
+        return self.get_response(request)
+
+
